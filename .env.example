# Local development defaults: `cp .env.example .env` is enough to start. Change them for any shared server.
MYSQL_DATABASE=bento
MYSQL_USER=bento
MYSQL_PASSWORD=bento-local-password
MYSQL_ROOT_PASSWORD=bento-local-root-password
APP_ENV=development
# Host port for the site (http://localhost:8080 by default).
WEB_PORT=8080
# Optional reference date for reproducible seed data; empty means today UTC.
SEED_DATE=
